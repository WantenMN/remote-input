<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_iconbox"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/header_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/green" />

        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/scan_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_ghost"
            android:contentDescription="@string/scan_qr"
            android:padding="12dp"
            android:src="@drawable/ic_scan"
            android:tint="@color/muted" />

    </LinearLayout>

    <TextView
        android:id="@+id/server_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/input_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/input_hint"
        android:inputType="textMultiLine"
        android:minLines="5"
        android:padding="16dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textCursorDrawable="@drawable/cursor"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/clear_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_ghost"
            android:contentDescription="@string/clear_input"
            android:padding="14dp"
            android:src="@drawable/ic_trash"
            android:tint="@color/muted" />

        <ImageButton
            android:id="@+id/history_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/btn_ghost"
            android:contentDescription="@string/history"
            android:padding="14dp"
            android:src="@drawable/ic_history"
            android:tint="@color/muted" />

        <LinearLayout
            android:id="@+id/send_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="2.5"
            android:background="@drawable/btn_send"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_send" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/send"
                android:textColor="@color/green_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
